// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// MVPスキーマ（docs/schema.md参照）

enum Gender {
  male
  female
  other
  no_answer
}

enum MuscleGroup {
  chest // 胸
  back // 背中
  legs // 脚
  shoulders // 肩
  arms // 腕
  glutes // お尻
  abs // 腹筋
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  displayName            String    @map("display_name")
  avatarUrl              String?   @map("avatar_url")
  birthDate              DateTime? @map("birth_date") @db.Date
  gender                 Gender?
  occupation             String?
  passwordResetToken     String?   @map("password_reset_token")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  workouts         Workout[]
  routines         Routine[]
  createdExercises Exercise[]    @relation("ExerciseCreatedBy")
  createdGroups    Group[]       @relation("GroupCreatedBy")
  groupMemberships GroupMember[]

  @@map("users")
}

// セッションの実体は connect-pg-simple が管理する（Prismaのマイグレーション管理外。
// 経緯はdocs/schema.mdの「設計方針メモ」参照）

model Exercise {
  id               String      @id @default(uuid())
  name             String
  muscleGroup      MuscleGroup @map("muscle_group")
  muscleDetail     String?     @map("muscle_detail") // 将来の細分類用
  // 部位ハイライト可視化（Phase2）用。詳細はdocs/muscle-highlight.md参照
  mainMuscle       String?     @map("main_muscle") // 主働筋。muscleGroupより細かい粒度（例:「大胸筋」）
  relatedMuscles   String[]    @default([]) @map("related_muscles") // 関連筋（例:["上腕三頭筋","三角筋前部"]）
  // mainMuscleとセットで初めて意味が確定する（同じ値でも部位によって指すものが違う）。対応表はdocs/muscle-highlight.md参照
  mainZone         String?     @map("main_zone")
  equipment        String?
  createdBy        String?     @map("created_by") // null=公式、値ありならカスタム種目
  defaultSortOrder Int?        @map("default_sort_order") // 運営が定番種目に設定。使用履歴が無い時のフォールバック順
  deletedAt        DateTime?   @map("deleted_at") @db.Timestamptz(3) // ソフトデリート。カスタム種目のみ、作成者本人が削除可能（公式種目は対象外）
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  // 公式種目名(created_by IS NULL)の重複防止は、DB制約ではなくアプリ側の重複サジェスト表示のみで運用する
  // （経緯はdocs/schema.mdの「設計方針メモ」参照。運営操作が複数人・同時実行になるタイミングで再検討）

  creator          User?             @relation("ExerciseCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  workoutSets      WorkoutSet[]
  routineExercises RoutineExercise[]

  @@index([createdBy])
  @@map("exercises")
}

model Workout {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  performedAt DateTime  @map("performed_at") @db.Date
  memo        String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3) // ソフトデリート。reactions/commentsを残すため

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets WorkoutSet[]

  @@index([userId, performedAt])
  @@map("workouts")
}

model WorkoutSet {
  id         String   @id @default(uuid())
  workoutId  String   @map("workout_id")
  exerciseId String   @map("exercise_id")
  setOrder   Int      @map("set_order")
  weightKg   Decimal? @map("weight_kg") // 自重種目はnull
  reps       Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([workoutId])
  @@index([exerciseId])
  @@map("workout_sets")
}

model Routine {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises RoutineExercise[]

  @@index([userId])
  @@map("routines")
}

model RoutineExercise {
  id         String @id @default(uuid())
  routineId  String @map("routine_id")
  exerciseId String @map("exercise_id")
  sortOrder  Int    @map("sort_order")
  targetSets Json?  @map("target_sets") // 目安セット([{weightKg, reps}, ...])。未設定はnull

  routine  Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([routineId])
  @@index([exerciseId])
  @@map("routine_exercises")
}

enum GroupMemberRole {
  owner
  member
}

// Phase4（交流とランキング）の土台。docs/schema.mdのPhase4節・「Phase4の検討結果」参照
model Group {
  id               String    @id @default(uuid())
  name             String
  createdBy        String    @map("created_by") // 作成者の記録用。権限判定はGroupMember.roleを見る
  inviteCode       String    @unique @map("invite_code") // 暗号学的乱数の英数字32文字程度
  inviteExpiresAt  DateTime? @map("invite_expires_at") @db.Timestamptz(3) // 再発行のたびに更新
  memberLimit      Int       @default(10) @map("member_limit") // 課金で拡張(Phase5)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3) // ソフトデリート。ownerのみ実行可

  creator User          @relation("GroupCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  members GroupMember[]

  @@index([createdBy])
  @@map("groups")
}

// 退会してもleft_atで論理管理し、行は物理削除しない(退会後も過去の記録・カスタム種目が仲間から見え続けるため。
// docs/schema.md「設計方針メモ」参照)。再参加はINSERTではなくこの行のUPDATE(left_atをNULLに戻す)で行う
model GroupMember {
  groupId  String          @map("group_id")
  userId   String          @map("user_id")
  role     GroupMemberRole @default(member)
  joinedAt DateTime        @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt   DateTime?       @map("left_at") @db.Timestamptz(3)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}
